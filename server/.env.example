# Copy to .env and load it before starting the API (e.g. `set -a; . ./.env; set +a`).

# --- AI (tutor, prompt grading, question variants)
ANTHROPIC_API_KEY=
# AI_QUEST_MODEL=claude-opus-5-5

# --- Database: SQLite for development, PostgreSQL in production
DATABASE_URL=sqlite:///./aiquest.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/aiquest

# --- Authentication
# Production: Supabase Auth. Set the project URL (JWKS / asymmetric keys) and/or the legacy JWT secret.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Development only: built-in e-mail login without passwords. Never enable in production.
AI_QUEST_DEV_AUTH=1
AI_QUEST_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# --- Payments (Stripe). Billing (FREE vs PREMIUM limits) is active when the key and premium price are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_BUSINESS=
# Turn on FREE/PREMIUM limits without Stripe (switch plans via /api/dev/plan in dev mode).
# AI_QUEST_BILLING=1
AI_QUEST_PUBLIC_URL=http://localhost:5173

# --- Limits
AI_QUEST_FREE_DAILY_AI=10
AI_QUEST_PREMIUM_DAILY_AI=200
AI_QUEST_RATE_LIMIT=30
AI_QUEST_RATE_WINDOW_S=600
AI_QUEST_CORS_ORIGINS=http://localhost:5173
